diff --git a/examples/echo-runtime-probe/runtime-probe.cpp b/examples/echo-runtime-probe/runtime-probe.cpp
new file mode 100644
--- /dev/null
+++ b/examples/echo-runtime-probe/runtime-probe.cpp
@@ -0,0 +1,31 @@
+#include "ggml-backend.h"
+
+#include <cstdio>
+#include <cstring>
+
+int main(int argc, char ** argv) {
+    ggml_backend_load_all();
+    ggml_backend_dev_t device = nullptr;
+    if (argc == 2 && std::strcmp(argv[1], "--cpu") == 0) {
+        device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    } else if (argc == 1) {
+        device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+        if (device == nullptr) {
+            device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_IGPU);
+        }
+    } else {
+        std::fprintf(stderr, "usage: echo-whisper-runtime-probe [--cpu]\n");
+        return 4;
+    }
+    if (device == nullptr) {
+        std::fprintf(stderr, "echo-whisper-runtime-probe: requested device is unavailable\n");
+        return 2;
+    }
+    ggml_backend_t backend = ggml_backend_dev_init(device, nullptr);
+    if (backend == nullptr) {
+        std::fprintf(stderr, "echo-whisper-runtime-probe: backend initialization failed\n");
+        return 3;
+    }
+    ggml_backend_free(backend);
+    return 0;
+}
